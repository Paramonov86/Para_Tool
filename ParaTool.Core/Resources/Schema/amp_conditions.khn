-- ========== PIRATE GRENADE MARKER SYSTEM ==========

-- Check if grenade slot N is the next free slot for grenade type
-- Used in SpellProperties IF() to apply correct marker
function NextPirateGrenadeSlot(grenadeNum, slotNum)
    local breast = GetItemInEquipmentSlot(EquipmentSlot.Breast, context.Source)
    for i = 1, slotNum - 1 do
        if not HasStatus('AMP_PIRATE_G' .. string.format('%02d', grenadeNum) .. '_USED_' .. i, breast).Result then
            return ConditionResult(false)
        end
    end
    return ~HasStatus('AMP_PIRATE_G' .. string.format('%02d', grenadeNum) .. '_USED_' .. slotNum, breast)
end

-- Check if character has any grenades left (any slot free)
-- Used in RequirementConditions to disable spell when all used
function PirateGrenadeAvailable(grenadeNum, maxUses)
    local breast = GetItemInEquipmentSlot(EquipmentSlot.Breast, context.Source)
    for i = 1, maxUses do
        if not HasStatus('AMP_PIRATE_G' .. string.format('%02d', grenadeNum) .. '_USED_' .. i, breast).Result then
            return ConditionResult(true)
        end
    end
    return ConditionResult(false)
end

-- ========== GUIDING BOLT SPELL CHECK ==========

-- ========== MELEE MAIN HAND ATTACK CHECK ==========

-- Matches Target_MainHandAttack and all its children/variants
-- Used for Reach shard (AMP_SHARD_CHAR_REACH) to increase melee weapon reach
function AMP_IsMeleeMainHandAttack()
    return IsSpellIdOrChild('Target_MainHandAttack')
    | IsSpellIdOrChild('Target_OffhandAttack')
end

-- Check if spell is Guiding Bolt or any of its variants
-- Used for AMP_Stardruid_Helmet - restores Cosmic Omen on cast
-- Includes: base Guiding Bolt, StarMap variant, Free variant
function IsGuidingBolt()
    return IsSpellIdOrChild('Projectile_GuidingBolt')
    | IsSpellIdOrChild('Projectile_GuidingBolt_StarMap')
    | IsSpellIdOrChild('Projectile_GuidingBolt_Free')
end

-- Check if spell is Inflict Wounds or any of its variants
-- Used for Zinghi's Tunic (MAG_Armour_C_4) - Necro Nuke rework
function IsNecroNuke()
    return IsSpellIdOrChild('Target_InflictWounds')
    | IsSpellIdOrChild('AMP_Target_InflictWounds')
end

-- Check if entity is resistant to Necrotic damage
-- Used for AMP_Target_InflictWounds self-damage condition
function IsResistantToNecroticDamage(entity)
    local entity = entity or context.Target
    return IsResistantToDamageType(DamageType.Necrotic, entity)
end

-- ========== ABILITY COMPARISON CHECKS ==========

-- Check if entity's Wisdom is greater than their Strength
-- Used for AMP_CaioShin_WisdomCrit_Passive - restore reaction on crit when Wisdom > Strength
function IsWisdomGreaterThanStrength(entity)
    entity = entity or context.Source
    return ConditionResult(entity.Wisdom > entity.Strength)
end

-- Check if entity's Charisma is greater than a given value
-- Usage: AMP_CharismaGreaterThan(22, context.Source)
function AMP_CharismaGreaterThan(value, entity)
    entity = entity or context.Source
    return ConditionResult(entity.Charisma > value)
end

-- Check if entity's Dexterity is strictly higher than all other abilities
function IsDexterityHighest(entity)
    entity = entity or context.Target
    local dex = entity.Dexterity
    return ConditionResult(
        dex > entity.Strength and
        dex > entity.Constitution and
        dex > entity.Intelligence and
        dex > entity.Wisdom and
        dex > entity.Charisma
    )
end

-- Check if entity's Intelligence is strictly higher than all other abilities
function IsIntelligenceHighest(entity)
    entity = entity or context.Target
    local int = entity.Intelligence
    return ConditionResult(
        int > entity.Strength and
        int > entity.Dexterity and
        int > entity.Constitution and
        int > entity.Wisdom and
        int > entity.Charisma
    )
end

-- Check if entity's Strength is strictly higher than all other abilities
-- Used for Force Maul exhaustion check - debuff when STR is not the highest
function IsStrengthHighest(entity)
    entity = entity or context.Target
    local str = entity.Strength
    return ConditionResult(
        str > entity.Dexterity and
        str > entity.Constitution and
        str > entity.Intelligence and
        str > entity.Wisdom and
        str > entity.Charisma
    )
end

-- ========== CHILL TOUCH SPELL CHECK ==========

-- Check if spell is Chill Touch or any of its variants
-- Used for Armour of the Sage Revenant toggle - removes Action Point cost
function IsChillTouch()
    return IsSpellIdOrChild('Target_ChillTouch')
end

-- ========== SELF-INTERACTION CHECKS ==========
-- Problem: Self() checks context.Source == context.Target.
-- Self(context.Source) is IDENTICAL to Self() because entity2 defaults to context.Target.
-- These helpers have explicit names so you never confuse which entity is checked.

-- For OnDamaged passive: "damage came from another entity, not myself"
-- Source = attacker, Target = victim (passive owner)
-- Also validates Source.IsValid — surface/environmental damage may have no valid Source
function IsDamagedByOther()
    return ConditionResult(context.Source.IsValid and context.Source ~= context.Target)
end

-- For OnDamaged passive: "I damaged myself" (self-harm, own surface, etc.)
function IsSelfDamage()
    return ConditionResult(context.Source.IsValid and context.Source == context.Target)
end

-- For OnDamage passive: "I'm attacking someone else, not myself"
-- Source = attacker (passive owner), Target = victim
function IsAttackingOther()
    return ConditionResult(context.Target.IsValid and context.Source ~= context.Target)
end

-- For OnHeal passive: "I'm healing someone else, not myself"
-- Source = healer (passive owner), Target = heal recipient
function IsHealingOther()
    return ConditionResult(context.Target.IsValid and context.Source ~= context.Target)
end

-- For OnHeal passive: "I'm healing myself"
function IsSelfHeal()
    return ConditionResult(context.Source.IsValid and context.Source == context.Target)
end

-- For OnStatusApplied passive: "status was applied by a different entity"
-- Source = who applied status, Target = who received status
function IsStatusFromOther()
    return ConditionResult(context.Source.IsValid and context.Source ~= context.Target)
end

-- For OnStatusApplied passive: "I applied this status to myself"
function IsStatusFromSelf()
    return ConditionResult(context.Source.IsValid and context.Source == context.Target)
end

-- For InterruptData: "observer is the one who attacked/cast"
-- Observer = interrupt owner, Source = attacker/caster, Target = victim
function IsObserverAttacker()
    return Self(context.Source, context.Observer)
end

-- For InterruptData: "observer is the one being attacked/targeted"
function IsObserverVictim()
    return Self(context.Target, context.Observer)
end

-- ========== SLOW STATUS CHECK ==========

-- Check if entity has any variant of Slow status
-- Used for N_Force necklace - crit threshold reduction while Slowed
-- Includes: base SLOW, TAD variants, Abjure Enemy, Gambler's modified
function IsSlow(entity)
    entity = entity or context.Target
    return HasStatus('SLOW', entity)
    | HasStatus('TAD_BLACK_HOLE_SLOW', entity)
    | HasStatus('ABJURE_ENEMY_SLOW', entity)
    | HasStatus('END_NETHERBRAIN_SLOW', entity)
    | HasStatus('AMP_GAMBLERS_SLOW_MODIFIED', entity)
end

-- ========== HASTE STATUS CHECK ==========

-- Check if entity has any variant of Haste status
-- Includes: base HASTE, Celestial, TAD Mind Sanctuary, Surface, Gambler's modified
function IsHasted(entity)
    entity = entity or context.Target
    return HasStatus('HASTE', entity)
    | HasStatus('MAG_CELESTIAL_HASTE', entity)
    | HasStatus('TAD_MIND_SANCTUARY_HASTE', entity)
    | HasStatus('HASTE_SURFACE', entity)
    | HasStatus('AMP_GAMBLERS_HASTE_MODIFIED', entity)
end

-- ========== TIME-AFFECTED CHECK ==========

-- Check if entity has any Haste or Slow variant
-- Combines IsHasted() and IsSlow() for unified time-manipulation check
function IsAffectedByTime(entity)
    entity = entity or context.Target
    return IsHasted(entity) | IsSlow(entity)
end

-- ========== FORCE DAMAGE RESISTANCE CHECK ==========

-- Check if entity is resistant to Force damage
-- Used for N_Force Graviton passive - self-slow bypass
function IsResistantToForceDamage(entity)
    local entity = entity or context.Source
    return IsResistantToDamageType(DamageType.Force, entity)
end

-- Check if entity is immune to Force damage
function IsImmuneToForceDamage(entity)
    local entity = entity or context.Source
    return IsImmuneToDamageType(DamageType.Force, entity)
end

-- ========== NECROMANCY CANTRIP CHECK ==========

-- Check if spell is a Necromancy school cantrip
-- Used for Reaper passive - universal +1 target for all necromancy cantrips
-- Replaces hardcoded list (ChillTouch, BurstingSinew, TollTheDead) with universal condition
function IsNecromancyCantrip()
    return IsCantrip() & IsSpellOfSchool(SpellSchool.Necromancy)
end

-- ========== SHIELD SAVING THROW FROM WEAPON ATTACK ==========

-- ========== NATURE ENSNARE STATUS CHECK ==========

-- Check if target has any vine/web/ensnare status
-- Used for Gwaeron's Edge (Kyzr commission) - bonus poison damage + crit threshold reduction
-- Includes: Ensnared (vines), Ensnaring Strike, Nature's Wrath, Web
function IsNatureEnsnare(entity)
    entity = entity or context.Target
    return HasStatus('ENSNARED_VINES', entity)
    | HasStatus('ENSNARED', entity)
    | HasStatus('NATURES_WRATH', entity)
    | HasStatus('ENSNARING_STRIKE_2', entity)
    | HasStatus('ENSNARING_STRIKE', entity)
    | HasStatus('WEB', entity)
end

-- ========== EARTH MYRMIDON WILDSHAPE CHECK ==========

-- Check if spell is Earth Myrmidon Wild Shape or its combat variant
-- Used for Chauntean Boots of Jubilation legendary - free Earth Myrmidon entry
function IsEarthMyrmidonWildShape()
    return IsSpellIdOrChild('Shout_WildShape_Myrmidon_Earth')
    | IsSpellIdOrChild('Shout_WildShape_Combat_Myrmidon_Earth')
end

-- ========== PSYCHIC DOMINANCE SPELL CHECK ==========

-- Check if spell is a psychic dominance spell (mind control themed)
-- Used for N_Psychic_Dominance - makes these spells free to cast
-- Includes: Sleep, Hideous Laughter, Crown of Madness, Hypnotic Pattern,
--           Confusion, Dominate Person, Dissonant Whispers
function IsPsychicDominance()
    return IsSpellIdOrChild('Target_Sleep')
    | IsSpellIdOrChild('Target_HideousLaughter')
    | IsSpellIdOrChild('Target_CrownOfMadness')
    | IsSpellIdOrChild('Target_HypnoticPattern')
    | IsSpellIdOrChild('Target_Confusion')
    | IsSpellIdOrChild('Target_DominatePerson')
    | IsSpellIdOrChild('Target_DissonantWhispers')
end

function IsWizard(entity)
    entity = entity or context.Source
    return Tagged('WIZARD', entity)
end

function IsWizardIceStorm(entity)
    entity = entity or context.Source
    return Tagged('WIZARD', entity) & IsSpellIdOrChild('Target_IceStorm')
end

-- Check if entity has no divine patron tag (none of the 10 Pledge gods)
-- Used for Atheist armor shards — true for non-clerics and clerics of unlisted deities
function IsAtheist(entity)
    entity = entity or context.Source
    return ~Tagged('CLERIC_MYSTRA', entity) &
           ~Tagged('CLERIC_SELUNE', entity) &
           ~Tagged('CLERIC_SHAR', entity) &
           ~Tagged('CLERIC_TYR', entity) &
           ~Tagged('CLERIC_TALOS', entity) &
           ~Tagged('CLERIC_ILMATER', entity) &
           ~Tagged('CLERIC_LOLTH', entity) &
           ~Tagged('CLERIC_LOVIATAR', entity) &
           ~Tagged('CLERIC_LATHANDER', entity) &
           ~Tagged('CLERIC_MIELIKKI', entity)
end

function IsBurningAgony()
    return IsSpellIdOrChild('Projectile_Fireball') |
           IsSpellIdOrChild('Target_FlameStrike')
end

-- Check if spell is Hold Person or any of its variants
-- Used for paralysis-related effects
function IsParalysis()
    return IsSpellIdOrChild('Target_HoldPerson')
end

-- Ring42 Fateweaver: SetRoll interrupt filters
-- Fatal(5) = offensive only, Balanced(10) = both, Giant(15) = defensive only

function Ring42_Fatal_Interesting()
    if context.InterruptedRoll.RollCritical ~= RollCritical.None then
        return ConditionResult(false)
    end
    local rollSuccess = context.InterruptedRoll.Total >= context.InterruptedRoll.Difficulty
    local dc = context.InterruptedRoll.Difficulty

    if HasInterruptedAttack().Result then
        return ConditionResult(Enemy(context.Observer, context.Source).Result and rollSuccess and dc > 5)
    end
    if HasInterruptedSavingThrow().Result then
        return ConditionResult(Enemy(context.Observer, context.Target).Result and rollSuccess and dc > 5)
    end
    return ConditionResult(false)
end

function Ring42_Balanced_Interesting()
    if context.InterruptedRoll.RollCritical ~= RollCritical.None then
        return ConditionResult(false)
    end
    local rollSuccess = context.InterruptedRoll.Total >= context.InterruptedRoll.Difficulty
    local dc = context.InterruptedRoll.Difficulty

    if HasInterruptedAttack().Result then
        local isEnemy = Enemy(context.Observer, context.Source).Result
        if isEnemy then
            return ConditionResult(rollSuccess and dc > 10)
        end
        return ConditionResult(not rollSuccess and dc <= 10)
    end
    if HasInterruptedSavingThrow().Result then
        local isEnemy = Enemy(context.Observer, context.Target).Result
        if isEnemy then
            return ConditionResult(rollSuccess and dc > 10)
        end
        return ConditionResult(not rollSuccess and dc <= 10)
    end
    return ConditionResult(false)
end

function Ring42_Giant_Interesting()
    if context.InterruptedRoll.RollCritical ~= RollCritical.None then
        return ConditionResult(false)
    end
    local rollSuccess = context.InterruptedRoll.Total >= context.InterruptedRoll.Difficulty
    local dc = context.InterruptedRoll.Difficulty

    if HasInterruptedAttack().Result then
        return ConditionResult(not Enemy(context.Observer, context.Source).Result and not rollSuccess and dc <= 15)
    end
    if HasInterruptedSavingThrow().Result then
        return ConditionResult(not Enemy(context.Observer, context.Target).Result and not rollSuccess and dc <= 15)
    end
    return ConditionResult(false)
end

function IsCharismaGEWisdom(entity)
    entity = entity or context.Source
    return ConditionResult(entity.Charisma >= entity.Wisdom)
end

-- ========== THE UNMADE LIBRARY (Boots #8) ==========

-- Checks if the cast spell matches the active school marker on the caster
-- Default entity = context.Source (OnCast passive context)
function IsMatchingSchool(entity)
    entity = entity or context.Source
    return (HasStatus('AMP_ARCANE_SCHOOL_EVOCATION', entity) & IsSpellOfSchool(SpellSchool.Evocation))
         | (HasStatus('AMP_ARCANE_SCHOOL_ABJURATION', entity) & IsSpellOfSchool(SpellSchool.Abjuration))
         | (HasStatus('AMP_ARCANE_SCHOOL_CONJURATION', entity) & IsSpellOfSchool(SpellSchool.Conjuration))
         | (HasStatus('AMP_ARCANE_SCHOOL_NECROMANCY', entity) & IsSpellOfSchool(SpellSchool.Necromancy))
         | (HasStatus('AMP_ARCANE_SCHOOL_TRANSMUTATION', entity) & IsSpellOfSchool(SpellSchool.Transmutation))
         | (HasStatus('AMP_ARCANE_SCHOOL_DIVINATION', entity) & IsSpellOfSchool(SpellSchool.Divination))
         | (HasStatus('AMP_ARCANE_SCHOOL_ENCHANTMENT', entity) & IsSpellOfSchool(SpellSchool.Enchantment))
         | (HasStatus('AMP_ARCANE_SCHOOL_ILLUSION', entity) & IsSpellOfSchool(SpellSchool.Illusion))
end

-- Arcane Recovery spell (includes all child variants)
function IsArcaneRecovery()
    return IsSpellIdOrChild('Shout_ArcaneRecovery')
end

-- Intelligence higher than all other ability scores
function IsIntelligenceHighest(entity)
    entity = entity or context.Source
    return ConditionResult(
        entity.Intelligence > entity.Strength
        and entity.Intelligence > entity.Dexterity
        and entity.Intelligence > entity.Constitution
        and entity.Intelligence > entity.Wisdom
        and entity.Intelligence > entity.Charisma
    )
end

function IsMeleeAttackSpell()
    return IsSpellIdOrChild('Target_MainHandAttack')
    | IsSpellIdOrChild('Target_OffhandAttack')
    | IsSpellIdOrChild('Target_UnarmedAttack')
    | IsSpellIdOrChild('Target_UnarmedStrike_Monk')
    | IsSpellIdOrChild('Target_PommelStrike')
    | IsSpellIdOrChild('Target_Slash')
    | IsSpellIdOrChild('Target_Slash_New')
    | IsSpellIdOrChild('Target_PiercingThrust')
    | ManeuverAndWeaponActionCheck()
end


-- ========== AMP Ilmater Expansion ==========
-- True when the current spell cast is one of the 40 Ilmater Stigma prayers
-- (10 schools x 4 tiers). Used by Flare (Ring T3-T4) for OnStatusApply
-- filtering, by Unbroken (Cloak T3-T4) to discount the Action cost of a
-- prayer, and by any future passive that must react specifically to the
-- casting of an Ilmater prayer rather than to any spell. IsSpellIdOrChild
-- also catches child variants so UnlockSpellVariant-derived forms still
-- register as Ilmater prayers.
function IsAMPIlmaterPrayer()
    return IsSpellIdOrChild('AMP_Ilmater_Prayer_Communion_1')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Communion_2')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Communion_3')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Communion_4')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Anchoring_1')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Anchoring_2')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Anchoring_3')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Anchoring_4')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Sealing_1')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Sealing_2')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Sealing_3')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Sealing_4')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Temperance_1')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Temperance_2')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Temperance_3')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Temperance_4')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Preaching_1')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Preaching_2')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Preaching_3')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Preaching_4')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Thread_1')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Thread_2')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Thread_3')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Thread_4')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Prophet_1')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Prophet_2')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Prophet_3')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Prophet_4')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Pain_1')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Pain_2')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Pain_3')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Pain_4')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Bone_1')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Bone_2')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Bone_3')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Bone_4')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Martyrdom_1')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Martyrdom_2')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Martyrdom_3')
         | IsSpellIdOrChild('AMP_Ilmater_Prayer_Martyrdom_4')
end


-- IsAMPIlmaterStigmaApplied — true when the status driving the current
-- StatsFunctor context is one of the 30 Ilmater Stigma variants (Amulet
-- tiers 1-4, Ring, Diadem tiers 1-4, Robe, Cloak, Gloves, Boots, Helmet
-- tiers 1-4, MediumArmor tiers 1-4, HeavyArmor tiers 1-4). Use inside
-- OnStatusApply passives that must only fire for stigma applications.
function IsAMPIlmaterStigmaApplied()
    return StatusId('AMP_STIGMA_AMULET_1') | StatusId('AMP_STIGMA_AMULET_2') |
           StatusId('AMP_STIGMA_AMULET_3') | StatusId('AMP_STIGMA_AMULET_4') |
           StatusId('AMP_STIGMA_RING') |
           StatusId('AMP_STIGMA_DIADEM_1') | StatusId('AMP_STIGMA_DIADEM_2') |
           StatusId('AMP_STIGMA_DIADEM_3') | StatusId('AMP_STIGMA_DIADEM_4') |
           StatusId('AMP_STIGMA_ROBE') |
           StatusId('AMP_STIGMA_CLOAK') |
           StatusId('AMP_STIGMA_GLOVES') |
           StatusId('AMP_STIGMA_BOOTS') |
           StatusId('AMP_STIGMA_HELMET_1') | StatusId('AMP_STIGMA_HELMET_2') |
           StatusId('AMP_STIGMA_HELMET_3') | StatusId('AMP_STIGMA_HELMET_4') |
           StatusId('AMP_STIGMA_MEDIUMARMOR_1') | StatusId('AMP_STIGMA_MEDIUMARMOR_2') |
           StatusId('AMP_STIGMA_MEDIUMARMOR_3') | StatusId('AMP_STIGMA_MEDIUMARMOR_4') |
           StatusId('AMP_STIGMA_HEAVYARMOR_1') | StatusId('AMP_STIGMA_HEAVYARMOR_2') |
           StatusId('AMP_STIGMA_HEAVYARMOR_3') | StatusId('AMP_STIGMA_HEAVYARMOR_4')
end


-- HasAnyAMPIlmaterStigma — true when the given entity carries any of the
-- 30 Ilmater Stigma variants. Used for the Bless fallback inside prayer
-- SpellProperties (a second stigma on the same target becomes Bless
-- instead of a duplicate), and for passives gated on "ally under any
-- Stigma" (Amulet Anointing, Ring WatchfulEye, MediumArmor Recompense,
-- HeavyArmor Intercession, etc.).
function HasAnyAMPIlmaterStigma(entity)
    return HasStatus('AMP_STIGMA_AMULET_1', entity) | HasStatus('AMP_STIGMA_AMULET_2', entity) |
           HasStatus('AMP_STIGMA_AMULET_3', entity) | HasStatus('AMP_STIGMA_AMULET_4', entity) |
           HasStatus('AMP_STIGMA_RING', entity) |
           HasStatus('AMP_STIGMA_DIADEM_1', entity) | HasStatus('AMP_STIGMA_DIADEM_2', entity) |
           HasStatus('AMP_STIGMA_DIADEM_3', entity) | HasStatus('AMP_STIGMA_DIADEM_4', entity) |
           HasStatus('AMP_STIGMA_ROBE', entity) |
           HasStatus('AMP_STIGMA_CLOAK', entity) |
           HasStatus('AMP_STIGMA_GLOVES', entity) |
           HasStatus('AMP_STIGMA_BOOTS', entity) |
           HasStatus('AMP_STIGMA_HELMET_1', entity) | HasStatus('AMP_STIGMA_HELMET_2', entity) |
           HasStatus('AMP_STIGMA_HELMET_3', entity) | HasStatus('AMP_STIGMA_HELMET_4', entity) |
           HasStatus('AMP_STIGMA_MEDIUMARMOR_1', entity) | HasStatus('AMP_STIGMA_MEDIUMARMOR_2', entity) |
           HasStatus('AMP_STIGMA_MEDIUMARMOR_3', entity) | HasStatus('AMP_STIGMA_MEDIUMARMOR_4', entity) |
           HasStatus('AMP_STIGMA_HEAVYARMOR_1', entity) | HasStatus('AMP_STIGMA_HEAVYARMOR_2', entity) |
           HasStatus('AMP_STIGMA_HEAVYARMOR_3', entity) | HasStatus('AMP_STIGMA_HEAVYARMOR_4', entity)
end


-- HasForeignStigma_X — true when the given entity carries any Ilmater
-- Stigma that does NOT belong to artifact category X. One helper per
-- artifact category (Amulet, Ring, Diadem, Robe, Cloak, Gloves, Boots,
-- Helmet, MediumArmor, HeavyArmor). Used for passives gated on "another
-- Stigma on the ally" — the condition must exclude the item's own stigma
-- tiers, otherwise the passive self-triggers whenever the wearer places
-- their own Stigma.

function HasForeignStigma_Amulet(entity)
    return HasStatus('AMP_STIGMA_RING', entity) |
           HasStatus('AMP_STIGMA_DIADEM_1', entity) | HasStatus('AMP_STIGMA_DIADEM_2', entity) |
           HasStatus('AMP_STIGMA_DIADEM_3', entity) | HasStatus('AMP_STIGMA_DIADEM_4', entity) |
           HasStatus('AMP_STIGMA_ROBE', entity) |
           HasStatus('AMP_STIGMA_CLOAK', entity) |
           HasStatus('AMP_STIGMA_GLOVES', entity) |
           HasStatus('AMP_STIGMA_BOOTS', entity) |
           HasStatus('AMP_STIGMA_HELMET_1', entity) | HasStatus('AMP_STIGMA_HELMET_2', entity) |
           HasStatus('AMP_STIGMA_HELMET_3', entity) | HasStatus('AMP_STIGMA_HELMET_4', entity) |
           HasStatus('AMP_STIGMA_MEDIUMARMOR_1', entity) | HasStatus('AMP_STIGMA_MEDIUMARMOR_2', entity) |
           HasStatus('AMP_STIGMA_MEDIUMARMOR_3', entity) | HasStatus('AMP_STIGMA_MEDIUMARMOR_4', entity) |
           HasStatus('AMP_STIGMA_HEAVYARMOR_1', entity) | HasStatus('AMP_STIGMA_HEAVYARMOR_2', entity) |
           HasStatus('AMP_STIGMA_HEAVYARMOR_3', entity) | HasStatus('AMP_STIGMA_HEAVYARMOR_4', entity)
end

